# The source is a prerelease. Numeric equality identifies only this coordinate;
# it makes no stable-release or future API compatibility promise.
set(PACKAGE_VERSION "@ZYNUM_PACKAGE_VERSION@")
set(PACKAGE_VERSION_COMPATIBLE FALSE)
set(PACKAGE_VERSION_EXACT FALSE)
if(PACKAGE_FIND_VERSION VERSION_EQUAL "@ZYNUM_PACKAGE_NUMERIC_VERSION@")
    set(PACKAGE_VERSION_COMPATIBLE TRUE)
endif()
if(PACKAGE_FIND_VERSION STREQUAL PACKAGE_VERSION)
    set(PACKAGE_VERSION_EXACT TRUE)
endif()
if(PACKAGE_FIND_VERSION_RANGE)
    set(PACKAGE_VERSION_COMPATIBLE FALSE)
endif()
