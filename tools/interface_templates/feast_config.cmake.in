# Generated FEAST4 LP64 compatibility profile provided by the unified Zynum SDK.
# Historical FEAST target names follow this single selected numerical owner.
get_filename_component(_zynum_feast_prefix "${CMAKE_CURRENT_LIST_DIR}/../../.." ABSOLUTE)
set(FEAST_VERSION "4.0.0")
set(FEAST_ZYNUM_PROFILE "feast4.lp64.abplas-v1")
set(FEAST_ZYNUM_FULL_COMPATIBILITY FALSE)
set(FEAST_INCLUDE_DIRS "${_zynum_feast_prefix}/include")
if(NOT EXISTS "${FEAST_INCLUDE_DIRS}/zynum/feast/feast_lp64.h" OR NOT EXISTS "${FEAST_INCLUDE_DIRS}/zynum/feast/abi_manifest.json")
  set(FEAST_FOUND FALSE)
  set(FEAST_NOT_FOUND_MESSAGE "The selected finite FEAST headers/manifest are missing")
  return()
endif()
if(NOT APPLE OR NOT CMAKE_SYSTEM_PROCESSOR MATCHES "^(arm64|aarch64)$" OR NOT CMAKE_SIZEOF_VOID_P EQUAL 8)
  set(FEAST_FOUND FALSE)
  set(FEAST_NOT_FOUND_MESSAGE "This finite Zynum FEAST profile requires Apple arm64 LP64")
  return()
endif()
if(TARGET ABPLASZynum::LP64)
  get_target_property(_zynum_feast_library ABPLASZynum::LP64 IMPORTED_LOCATION)
  get_filename_component(_zynum_feast_owner "${_zynum_feast_library}" REALPATH)
  get_filename_component(_zynum_feast_shared "${_zynum_feast_prefix}/lib/libzynum_abplas_lp64.dylib" REALPATH)
  get_filename_component(_zynum_feast_static "${_zynum_feast_prefix}/lib/libzynum_abplas_lp64.a" REALPATH)
  if(NOT _zynum_feast_owner STREQUAL _zynum_feast_shared AND NOT _zynum_feast_owner STREQUAL _zynum_feast_static)
    set(FEAST_FOUND FALSE)
    set(FEAST_NOT_FOUND_MESSAGE "FEAST and ABPLaS selected different unified Zynum SDK libraries")
    return()
  endif()
  set(_zynum_feast_core ABPLASZynum::LP64)
else()
  if(EXISTS "${_zynum_feast_prefix}/lib/libzynum_abplas_lp64.dylib")
    set(_zynum_feast_library "${_zynum_feast_prefix}/lib/libzynum_abplas_lp64.dylib")
  else()
    set(_zynum_feast_library "${_zynum_feast_prefix}/lib/libzynum_abplas_lp64.a")
  endif()
  if(NOT EXISTS "${_zynum_feast_library}")
    set(FEAST_FOUND FALSE)
    set(FEAST_NOT_FOUND_MESSAGE "The selected unified Zynum library is missing")
    return()
  endif()
  if(TARGET FEAST::ZynumCore)
    get_target_property(_zynum_feast_existing FEAST::ZynumCore IMPORTED_LOCATION)
    if(NOT _zynum_feast_existing STREQUAL _zynum_feast_library)
      set(FEAST_FOUND FALSE)
      set(FEAST_NOT_FOUND_MESSAGE "One CMake graph cannot select two Zynum FEAST owners")
      return()
    endif()
  else()
    add_library(FEAST::ZynumCore UNKNOWN IMPORTED GLOBAL)
    set_target_properties(FEAST::ZynumCore PROPERTIES IMPORTED_LOCATION "${_zynum_feast_library}" INTERFACE_INCLUDE_DIRECTORIES "${FEAST_INCLUDE_DIRS}")
  endif()
  set(_zynum_feast_core FEAST::ZynumCore)
endif()
if(NOT EXISTS "${_zynum_feast_library}")
  set(FEAST_FOUND FALSE)
  set(FEAST_NOT_FOUND_MESSAGE "The selected unified Zynum library is missing")
  return()
endif()
foreach(_zynum_feast_target IN ITEMS FEAST::feast_static FEAST::feast FEAST::feast_shared)
  if(TARGET ${_zynum_feast_target})
    get_target_property(_zynum_feast_existing ${_zynum_feast_target} ZYNUM_FEAST_OWNER)
    if(NOT _zynum_feast_existing STREQUAL _zynum_feast_library)
      set(FEAST_FOUND FALSE)
      set(FEAST_NOT_FOUND_MESSAGE "An incompatible FEAST provider target is already present")
      return()
    endif()
  else()
    add_library(${_zynum_feast_target} INTERFACE IMPORTED GLOBAL)
    set_target_properties(${_zynum_feast_target} PROPERTIES INTERFACE_LINK_LIBRARIES "${_zynum_feast_core}" INTERFACE_INCLUDE_DIRECTORIES "${FEAST_INCLUDE_DIRS}" ZYNUM_FEAST_OWNER "${_zynum_feast_library}")
  endif()
endforeach()
set(FEAST_LIBRARY_PATHS "${_zynum_feast_library}")
set(FEAST_LIBRARIES FEAST::feast_static)
set(FEAST_FOUND TRUE)
