* text=auto eol=lf

*.zig text eol=lf
*.zon text eol=lf
*.S text eol=lf
*.h text eol=lf
*.f90 text eol=lf
*.md text eol=lf
*.py text eol=lf
*.js text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Exclude Python engineering tooling from language statistics.
# These files remain maintained source, not vendored or generated code.
tools/**/*.py linguist-detectable=false
bench/tools/**/*.py linguist-detectable=false
test/**/*.py linguist-detectable=false

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.pdf binary

# Preserve the bytes recorded in dated benchmark artifact hashes.
docs/assets/benchmarks/2026-09-14/*.csv -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
docs/assets/benchmarks/2026-09-21/*.csv -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
